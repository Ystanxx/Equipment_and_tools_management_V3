DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/equipment_mgmt
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin
SUPER_ADMIN_EMAIL=admin@example.com
UPLOAD_DIR=./uploads

# SMTP 邮件通知配置；Outlook 示例使用 587 + STARTTLS
# 注意：Outlook.com 当前官方认证方式是 OAuth2/Modern Auth，普通 SMTP 密码可能无法通过。
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your-account@outlook.com
SMTP_PASSWORD=your-app-password-or-provider-token
SMTP_FROM_NAME=器材管理系统
SMTP_FROM_EMAIL=your-account@outlook.com
